{
  "name": "sim-one-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SIM-ONE Alpha — Flue-based multi-purpose orchestrating agent foundation.",
  "license": "MIT",
  "files": [
    ".gorombo/sim-one-alpha/**",
    ".gorombo/sim-one-cli/**",
    ".gorombo/sim-one-ratatui/**",
    "scripts/test-built-http.mjs",
    "scripts/smoke-http-endpoints.mjs",
    "AUTHORS.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md",
    ".env.example"
  ],
  "scripts": {
    "build": "flue build --target node && node scripts/generate-builtin-registry.mjs && node scripts/copy-runtime-config.mjs && node scripts/copy-wasm-artifact.mjs",
    "build:cli": "pnpm --filter sim-one-cli run build",
    "build:tui": "node scripts/build-ratatui-tui.mjs",
    "build:tui:ratatui": "pnpm run build:tui",
    "build:all": "pnpm run build && pnpm run build:tui && pnpm run build:cli && node scripts/check-sim-one-product-command.mjs",
    "connect": "flue connect orchestrator local --target node --session local",
    "dev": "flue dev --target node",
    "docs:check": "python3 scripts/check-documentation.py",
    "test:unit": "node scripts/run-unit-tests.mjs && node --test scripts/product-artifact-lock.test.mjs",
    "test:http": "node scripts/test-built-http.mjs",
    "test:tui": "node scripts/test-tui-e2e.mjs",
    "test:tui:ratatui": "node scripts/test-ratatui-product.mjs",
    "test:lsp": "node scripts/run-unit-tests.mjs -- src/tests/lsp-integration.test.ts",
    "smoke:http": "node scripts/smoke-http-endpoints.mjs",
    "research:local": "node scripts/research.mjs",
    "protocols:seed": "node scripts/protocol-admin.mjs seed",
    "protocols:list": "node scripts/protocol-admin.mjs list",
    "protocols:add": "node scripts/protocol-admin.mjs add",
    "protocols:remove": "node scripts/protocol-admin.mjs remove",
    "protocols:enable": "node scripts/protocol-admin.mjs enable",
    "protocols:disable": "node scripts/protocol-admin.mjs disable",
    "capabilities:list": "node scripts/capability-admin.mjs list",
    "capabilities:add": "node scripts/capability-admin.mjs add",
    "capabilities:enable": "node scripts/capability-admin.mjs enable",
    "capabilities:disable": "node scripts/capability-admin.mjs disable",
    "capabilities:remove": "node scripts/capability-admin.mjs remove",
    "capabilities:update": "node scripts/capability-admin.mjs update",
    "start": "node --env-file=.env .gorombo/sim-one-alpha/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit && pnpm run build && pnpm run test:http",
    "fetch-embedding-model": "node scripts/fetch-embedding-model.mjs",
    "wasm:build": "node scripts/wasm-build.mjs",
    "prebuild": "node scripts/wasm-build.mjs",
    "smoke:memory": "node scripts/smoke-memory-helper.mjs",
    "cargo:test": "cargo test --workspace"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "overrides": {
      "@flue/cli>@cloudflare/vite-plugin": "1.47.0",
      "@flue/telegram>hono": "4.12.32",
      "@modelcontextprotocol/sdk>@hono/node-server": "2.0.11",
      "onnxruntime-node>adm-zip": "0.6.0",
      "brace-expansion": "5.0.8",
      "fast-uri": "3.1.4",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "tsup>esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "@ai-sdk/provider": "^3.0.10",
    "@astrojs/language-server": "^2.16.13",
    "@flue/runtime": "1.0.0-beta.1",
    "@flue/telegram": "1.0.0-beta.1",
    "@hono/node-server": "^2.0.11",
    "@huggingface/tokenizers": "^0.1.3",
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@runpod/ai-sdk-provider": "^1.4.0",
    "ai": "^6.0.205",
    "croner": "^10.0.1",
    "grammy": "^1.44.0",
    "hono": "^4.12.32",
    "js-yaml": "^4.3.0",
    "onnxruntime-node": "^1.27.0",
    "proper-lockfile": "^4.1.2",
    "pyright": "^1.1.410",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.3.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "1.0.0-beta.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/proper-lockfile": "^4.1.4",
    "esbuild": "0.28.1",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.10.0"
}
